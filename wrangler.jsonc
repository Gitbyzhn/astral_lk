// Cloudflare Workers нұсқасы (тегін): README → «Тегін: Cloudflare».
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "astral-lk",
  "main": "worker/index.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  // database_id көрсетілмеген: `wrangler deploy` (v4.45+) D1 базасын бірінші рет өзі жасап, Worker-ге қосады.
  // Кестелерді Worker өзі жасайды (migrations/0001_init.sql, IF NOT EXISTS).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "astral-lk",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_TIMEZONE": "Asia/Almaty"
  },
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "observability": { "enabled": true }
}
